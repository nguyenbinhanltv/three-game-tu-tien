node_modules
dist
*.db
*.db-*
.env.local
apps/server/data
# Đầu vào pipeline (GLB Blender xuất / import Tripo) và cache: sinh lại được, không commit.
assets/build/
bench/results

# File nguồn asset lớn nằm ngoài repo (DTL_ASSET_SOURCE, xem docs/tripo-runbook.md mục 2).
# Trong assets/source/ chỉ commit meta.json, nhật ký đợt CLI và README.
assets/source/**
!assets/source/**/
!assets/source/**/meta.json
!assets/source/_batches/*.json
!assets/source/README.md
tripo-out/

__pycache__/
*.pyc

# Cache asset kéo từ R2 (pnpm assets:pull), sinh lại được.
.asset-cache/

# Nhị phân asset game nằm trên R2, không commit (R2-3): `pnpm assets:pull` tải về đây theo assets/asset-lock.json,
# `pnpm assets:push` đẩy file mới lên R2 và cập nhật sổ khóa. Font (woff2) và manifest json vẫn do git giữ.
apps/client/public/**/*.glb
apps/client/public/**/*.ktx2
apps/client/public/**/*.webp
apps/client/public/**/*.png
apps/client/public/**/*.webm
apps/client/public/**/*.m4a
apps/client/public/**/*.ogg
