{
  "name": "dap-thien-lo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"pnpm --filter @dtl/server dev\" \"pnpm --filter @dtl/client dev\"",
    "dev:server": "pnpm --filter @dtl/server dev",
    "dev:client": "pnpm --filter @dtl/client dev",
    "build": "pnpm --filter @dtl/client build",
    "start": "pnpm --filter @dtl/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:slow": "pnpm audio:test",
    "test:all": "pnpm test && pnpm test:slow",
    "content:check": "pnpm --filter @dtl/content check && pnpm icons:check",
    "sim:progress": "pnpm --filter @dtl/content sim",
    "map:report": "pnpm --filter @dtl/content map:report",
    "bots": "pnpm --filter @dtl/bot-client start",
    "ledger:check": "pnpm --filter @dtl/server ledger:check",
    "size": "pnpm --filter @dtl/perf size",
    "bench:client": "pnpm --filter @dtl/perf bench",
    "bench:switch": "pnpm --filter @dtl/perf bench --switch 20",
    "compat": "pnpm --filter @dtl/perf compat",
    "bench:load": "pnpm --filter @dtl/perf load",
    "bench:crowd": "pnpm --filter @dtl/perf crowd",
    "bench:levels": "pnpm --filter @dtl/perf levels",
    "assets:build": "pnpm --filter @dtl/asset-pipeline run build",
    "assets:optimize": "pnpm --filter @dtl/asset-pipeline run optimize",
    "shots": "pnpm --filter @dtl/perf run shots --",
    "check:black": "pnpm --filter @dtl/perf run check:black",
    "assets:terrain": "pnpm --filter @dtl/asset-pipeline exec tsx src/terrain-textures.ts",
    "assets:grass-cards": "pnpm --filter @dtl/asset-pipeline exec tsx src/grass-cards.ts",
    "assets:hires": "pnpm --filter @dtl/asset-pipeline exec tsx src/hires.ts",
    "assets:validate": "pnpm --filter @dtl/asset-pipeline run validate",
    "assets:impostor": "pnpm --filter @dtl/asset-pipeline run impostor",
    "audio:build": "node tools/audio/build.mjs",
    "audio:check": "node tools/audio/build.mjs --check && node tools/audio/loop.mjs --check && node tools/audio/levels.mjs --check",
    "audio:levels": "node tools/audio/levels.mjs --write",
    "audio:test": "node --test tools/audio/loop.test.mjs tools/audio/compose.test.mjs tools/audio/stems.test.mjs tools/audio/levels.test.mjs",
    "music:build": "node tools/audio/loop.mjs",
    "music:check": "node tools/audio/loop.mjs --check",
    "palette": "node tools/palette/gen_palette.mjs",
    "minimap:build": "pnpm --filter @dtl/asset-pipeline minimap",
    "palette:check": "node tools/palette/gen_palette.mjs --check",
    "invite": "pnpm --filter @dtl/server invite",
    "icons:build": "node tools/icons/build.mjs",
    "icons:check": "node tools/icons/build.mjs --check",
    "lint": "eslint .",
    "deps:check": "madge --circular --extensions ts --ts-config packages/shared/tsconfig.json --no-spinner packages/shared/src",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css}\"",
    "docs:check": "node tools/docs/check.mjs",
    "docs:paths": "node tools/docs/check-paths.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "madge": "^8.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
