{
  "name": "dap-thien-lo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"pnpm --filter @dtl/server dev\" \"pnpm --filter @dtl/client dev\"",
    "dev:server": "pnpm --filter @dtl/server dev",
    "dev:client": "pnpm --filter @dtl/client dev",
    "build": "pnpm --filter @dtl/client build",
    "start": "pnpm --filter @dtl/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm audio:test",
    "content:check": "pnpm --filter @dtl/content check && pnpm icons:check",
    "sim:progress": "pnpm --filter @dtl/content sim",
    "map:report": "pnpm --filter @dtl/content map:report",
    "bots": "pnpm --filter @dtl/bot-client start",
    "ledger:check": "pnpm --filter @dtl/server ledger:check",
    "size": "pnpm --filter @dtl/perf size",
    "bench:client": "pnpm --filter @dtl/perf bench",
    "bench:switch": "pnpm --filter @dtl/perf bench --switch 20",
    "compat": "pnpm --filter @dtl/perf compat",
    "bench:load": "pnpm --filter @dtl/perf load",
    "bench:crowd": "pnpm --filter @dtl/perf crowd",
    "bench:levels": "pnpm --filter @dtl/perf levels",
    "assets:build": "pnpm --filter @dtl/asset-pipeline run build",
    "assets:optimize": "pnpm --filter @dtl/asset-pipeline run optimize",
    "shots": "pnpm --filter @dtl/perf run shots --",
    "check:black": "pnpm --filter @dtl/perf run check:black",
    "shots:method": "pnpm --filter @dtl/perf run shots:method --",
    "shots:party": "pnpm --filter @dtl/perf run shots:party --",
    "shots:p38": "pnpm --filter @dtl/perf run shots:p38 --",
    "shots:m5": "pnpm --filter @dtl/perf run shots:m5 --",
    "shots:sets": "pnpm --filter @dtl/perf run shots:sets --",
    "shots:outfit": "pnpm --filter @dtl/perf run shots:outfit --",
    "shots:k1": "pnpm --filter @dtl/perf run shots:k1 --",
    "shots:k3": "pnpm --filter @dtl/perf run shots:k3 --",
    "shots:k4": "pnpm --filter @dtl/perf run shots:k4 --",
    "shots:k6": "pnpm --filter @dtl/perf run shots:k6 --",
    "shots:vfx": "pnpm --filter @dtl/perf run shots:vfx --",
    "shots:e2g": "pnpm --filter @dtl/perf run shots:e2g --",
    "shots:e2codex": "pnpm --filter @dtl/perf run shots:e2codex --",
    "shots:e1e": "pnpm --filter @dtl/perf run shots:e1e --",
    "shots:k7": "pnpm --filter @dtl/perf run shots:k7 --",
    "shots:e2a": "pnpm --filter @dtl/perf run shots:e2a --",
    "shots:e3a": "pnpm --filter @dtl/perf run shots:e3a --",
    "shots:e4a": "pnpm --filter @dtl/perf run shots:e4a --",
    "shots:e2b": "pnpm --filter @dtl/perf run shots:e2b --",
    "shots:e3b": "pnpm --filter @dtl/perf run shots:e3b --",
    "shots:e4b": "pnpm --filter @dtl/perf run shots:e4b --",
    "shots:e3j": "pnpm --filter @dtl/perf run shots:e3j --",
    "shots:e2c": "pnpm --filter @dtl/perf run shots:e2c --",
    "shots:e3m": "pnpm --filter @dtl/perf run shots:e3m --",
    "shots:boss": "pnpm --filter @dtl/perf run shots:boss --",
    "shots:trib": "pnpm --filter @dtl/perf run shots:trib --",
    "shots:e2d": "pnpm --filter @dtl/perf run shots:e2d --",
    "shots:e3l": "pnpm --filter @dtl/perf run shots:e3l --",
    "shots:e2h": "pnpm --filter @dtl/perf run shots:e2h --",
    "shots:e2e": "pnpm --filter @dtl/perf run shots:e2e --",
    "shots:e3k": "pnpm --filter @dtl/perf run shots:e3k --",
    "shots:eqicons": "pnpm --filter @dtl/perf run shots:eqicons --",
    "shots:m4": "pnpm --filter @dtl/perf run shots:m4 --",
    "shots:kiem": "pnpm --filter @dtl/perf run shots:kiem --",
    "shots:props": "pnpm --filter @dtl/perf run shots:props --",
    "shots:elite": "pnpm --filter @dtl/perf run shots:elite --",
    "shots:elitegame": "pnpm --filter @dtl/perf run shots:elitegame --",
    "shots:e0": "pnpm --filter @dtl/perf run shots:e0 --",
    "assets:terrain": "pnpm --filter @dtl/asset-pipeline exec tsx src/terrain-textures.ts",
    "assets:grass-cards": "pnpm --filter @dtl/asset-pipeline exec tsx src/grass-cards.ts",
    "assets:validate": "pnpm --filter @dtl/asset-pipeline run validate",
    "assets:impostor": "pnpm --filter @dtl/asset-pipeline run impostor",
    "audio:build": "node tools/audio/build.mjs",
    "audio:check": "node tools/audio/build.mjs --check && node tools/audio/loop.mjs --check && node tools/audio/levels.mjs --check",
    "audio:levels": "node tools/audio/levels.mjs --write",
    "audio:test": "node --test tools/audio/loop.test.mjs tools/audio/compose.test.mjs tools/audio/stems.test.mjs tools/audio/levels.test.mjs",
    "music:build": "node tools/audio/loop.mjs",
    "music:check": "node tools/audio/loop.mjs --check",
    "palette": "node tools/palette/gen_palette.mjs",
    "minimap:build": "pnpm --filter @dtl/asset-pipeline minimap",
    "palette:check": "node tools/palette/gen_palette.mjs --check",
    "invite": "pnpm --filter @dtl/server invite",
    "icons:build": "node tools/icons/build.mjs",
    "icons:check": "node tools/icons/build.mjs --check",
    "docs:check": "node tools/docs/check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
