      { "id": "rift_ash", "hex": "#2A2426", "label": "Tro than", "role": "đất, đá, giáp nền của dị vực; không đen tuyền" },
      { "id": "rift_ash_light", "hex": "#8C8580", "label": "Tro bay", "role": "sương dị vực (thay air_mist), bụi, da Tẫn chủng" },
      { "id": "rift_ember", "hex": "#C4412B", "label": "Than hồng", "role": "khe nứt trên da thú, lưỡi kiếm lửa, mắt; phát sáng" },
