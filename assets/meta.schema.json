{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dap-thien-lo.local/assets/meta.schema.json",
  "title": "meta.json của một asset (assets/source/<loại>/<asset_id>/meta.json)",
  "description": "Hồ sơ nhẹ của asset: concept, các lần sinh Tripo, ngân sách, giấy phép. File lớn nằm ở DTL_ASSET_SOURCE (../dtl-asset-source). Xem docs/tripo-runbook.md mục 4.",
  "type": "object",
  "required": ["id", "type", "status", "license"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^(chr|mon|boss|prop|arch|fx|anim)_[a-z0-9]+(_[a-z0-9]+)*$",
      "description": "Asset id: tiền tố loại + snake_case không dấu; trùng tên thư mục và tên GLB trong assets/build/raw/."
    },
    "type": { "enum": ["chr", "mon", "prop", "arch", "fx", "anim"], "description": "Thư mục loại trong assets/source/." },
    "budgetClass": {
      "enum": ["player", "npc", "monster", "boss", "weapon", "prop", "drop", "arch", "fx", "anim"],
      "description": "Lớp ngân sách trong assets/budgets.json. Bỏ trống thì suy từ tiền tố id (chr_ → player, mon_ → monster…)."
    },
    "itemId": { "type": ["string", "null"], "description": "Id vật phẩm trong packages/content nếu asset là hình của vật phẩm." },
    "status": {
      "enum": ["planned", "concept_approved", "generated", "rigged", "animated", "imported", "in_game", "rejected"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "faceLimit": { "type": "integer", "minimum": 0 },
        "texture": { "type": "integer", "minimum": 0 }
      }
    },
    "procedural": {
      "type": "object",
      "description": "Asset sinh thủ tục: script và seed để sinh lại.",
      "required": ["script"],
      "additionalProperties": false,
      "properties": {
        "script": { "type": "string" },
        "seed": { "type": ["integer", "string", "null"] }
      }
    },
    "import": {
      "type": "object",
      "description": "Nhập GLB ngoài (Tripo) qua tools/blender/import_tripo.py. tools/blender/run.mjs tự tạo job cho mọi meta.json có khối này. Xem assets/README.md mục Nhập Tripo.",
      "required": ["kind", "source", "size"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["tripo"] },
        "source": { "type": "string", "description": "GLB gốc, tương đối DTL_ASSET_SOURCE (../dtl-asset-source), ví dụ prop/prop_lo_dan/tripo/raw_v01.glb." },
        "size": {
          "type": "object",
          "description": "Kích thước thật (mét) của đúng một cạnh hộp bao ở tư thế nghỉ; scale đều theo cạnh này.",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 },
            "longest": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "orient": {
          "enum": ["auto", "thigh", "none"],
          "description": "auto (mặc định): có cặp xương đùi trái/phải thì xoay cho bên trái nhân vật về +X, mặt nhìn +Z; thigh: bắt buộc có; none: không tự xoay."
        },
        "yaw": { "type": "number", "description": "Xoay thêm quanh +Y (độ, ngược chiều kim đồng hồ nhìn từ trên) sau bước orient, để mặt trước nhìn về +Z." },
        "post": {
          "type": "string",
          "pattern": "^tools/blender/[a-z0-9_]+\\.py$",
          "description": "Script bpy chạy sau khi chuẩn hóa, trước khi xuất (đường dẫn từ gốc repo), ví dụ tools/blender/anim_quadruped.py: đổi tên xương, thêm clip thủ tục."
        },
        "sockets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "position"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^socket_[a-z0-9]+(_[a-z0-9]+)*$" },
              "position": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3,
                "description": "Tọa độ glTF (Y lên, mét) sau chuẩn hóa: gốc ở đáy, mặt trước +Z."
              },
              "bone": { "type": "string", "description": "Gắn vào xương này (vị trí vẫn theo tọa độ thế giới ở tư thế nghỉ)." }
            }
          }
        }
      }
    },
    "concept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "view", "tool", "date"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "view": { "enum": ["front", "left", "back", "right", "34"] },
          "tool": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "prompt": { "type": "string" },
          "chosen": { "type": "boolean" }
        }
      }
    },
    "tripo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "channel", "version", "date", "result"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "string" },
          "channel": { "enum": ["web", "cli"] },
          "version": { "type": "integer", "minimum": 1 },
          "taskId": { "type": ["string", "null"] },
          "webUrl": { "type": ["string", "null"] },
          "parentTaskId": { "type": ["string", "null"] },
          "model": { "type": "string" },
          "params": { "type": "object" },
          "seed": { "type": ["integer", "null"] },
          "quote": { "type": ["number", "null"] },
          "credits": { "type": ["number", "null"] },
          "batch": { "type": ["string", "null"] },
          "date": { "type": "string", "format": "date" },
          "output": { "type": ["string", "null"] },
          "result": { "enum": ["ok", "failed", "rejected"] },
          "note": { "type": "string" }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["source", "owner", "date"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "description": "Ví dụ: Tripo (API trả phí) + Codex; CC0 Quaternius; tự sinh bằng script." },
        "owner": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "url": { "type": "string" },
        "spdx": { "type": "string", "description": "Mã SPDX nếu là giấy phép mở, ví dụ CC0-1.0, CC-BY-4.0." }
      }
    }
  }
}
