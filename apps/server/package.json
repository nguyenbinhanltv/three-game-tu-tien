    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.0",
    "google-auth-library": "^10.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "vitest": "^3.2.7"
