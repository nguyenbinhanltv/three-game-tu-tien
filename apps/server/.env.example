# Sao chép thành .env.local rồi sửa.
# Chỉ bật khi phát triển ở máy local. KHÔNG bật trên VPS.
AUTH_DEV_BYPASS=0
PORT=2567
# Client ID của Google (OAuth 2.0 Web application)
GOOGLE_CLIENT_ID=
# 1 = bỏ qua danh sách mời
OPEN_INVITE=0
# Số người tối đa mỗi kênh (mặc định 50)
MAX_CLIENTS=50
# Giới hạn tần suất POST /matchmake và bắt tay WebSocket theo IP (token bucket, mỗi loại một xô)
RATE_LIMIT_BURST=40
RATE_LIMIT_PER_MIN=20
# 1 = đọc IP thật từ X-Forwarded-For (chỉ bật khi đứng sau reverse proxy của mình)
TRUST_PROXY=0
# Miễn giới hạn cho bot/test ở máy dev, ví dụ: loopback hoặc 127.0.0.1,::1 (bị bỏ qua khi NODE_ENV=production)
RATE_LIMIT_EXEMPT=
