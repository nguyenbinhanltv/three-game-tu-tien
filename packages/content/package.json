{
  "name": "@dtl/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./loot": "./src/loot.ts",
    "./places": "./src/places.ts",
    "./fixtures": "./src/fixtures.ts",
    "./sim-model": "./src/simparts/common.ts",
    "./colliders-lazy": "./src/colliders.lazy.ts",
    "./hot": "./src/hot.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "tsx src/check.ts && tsx src/gen-sources.ts --check",
    "sim": "tsx src/sim.ts",
    "i18n:orphans": "tsx src/i18nOrphans.ts",
    "map:report": "tsx src/mapreport.ts",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "sources:build": "tsx src/gen-sources.ts",
    "sources:check": "tsx src/gen-sources.ts --check"
  },
  "dependencies": {
    "@dtl/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
