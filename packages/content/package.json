{
  "name": "@dtl/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./loot": "./src/loot.ts",
    "./places": "./src/places.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "tsx src/check.ts && tsx src/gen-sources.ts --check",
    "sim": "tsx src/sim.ts",
    "map:report": "tsx src/mapreport.ts",
    "test": "vitest run",
    "sources:build": "tsx src/gen-sources.ts",
    "sources:check": "tsx src/gen-sources.ts --check"
  },
  "dependencies": {
    "@dtl/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
